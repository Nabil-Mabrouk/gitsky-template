<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ project_name }}</title>
    <!-- Polices réelles (Round A design pass) : le brief de marque (Chap 24)
         choisit Fraunces/Archivo/Inter par skin depuis toujours, mais rien ne
         les chargeait nulle part dans le projet — chaque page retombait
         silencieusement sur system-ui. URLs explicites par skin (pas de
         formule générique) : Fraunces a un axe optical-size (opsz) propre,
         une formule fragiliserait le rendu pour économiser une ligne. Casse
         la propriété "zéro requête externe" de la page (reste zéro JS, zéro
         nouvelle infra serveur) — accepté sciemment pour ce gain. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% if landing.skin == "editorial" %}
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    {% elif landing.skin == "bold" %}
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    {% else %}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% endif %}
    <style>
      :root {
        --primary: {{ branding.primary_color }};
        --on-primary: {{ branding.primary_foreground }};
        --font: "{{ branding.font_family }}", system-ui, sans-serif;
        --font-display: "{{ branding.display_font_family }}", var(--font);
        --bg: #ffffff;
        --surface: #ffffff;
        --text: #111111;
        --border: rgba(0, 0, 0, 0.08);
        --nav-bg: rgba(255, 255, 255, 0.92);
      }
      /* Dark mode automatique (OS/navigateur du visiteur), ZÉRO JS — pas de
         toggle : cohérent avec le choix déjà fait pour le reveal au scroll
         (CSS pur plutôt que JS/IntersectionObserver, cf. plus bas), et une
         page vue une fois n'a pas besoin de mémoriser une préférence. Change
         uniquement les tokens de SURFACE/texte — --primary reste le même
         (l'identité de marque ne doit pas changer entre les deux modes). */
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0c;
          --surface: #151517;
          --text: #f2f2f0;
          --border: rgba(255, 255, 255, 0.12);
          --nav-bg: rgba(11, 11, 12, 0.85);
          /* --primary utilisé comme COULEUR DE TEXTE (badge, etc.) sur fond
             sombre a besoin d'être éclairci. Vérifié numériquement (script
             contrast_ratio du guardrail) sur les 10 primaires curées + Bleu
             France (#000091, politique-ia) : un mix à 68% vers blanc échoue
             le contraste WCAG AA pour les primaires les plus sombres
             (#1A1A1A, #000091 -> ~3.0, sous le seuil 4.5) — 40% primaire /
             60% blanc donne un pire cas de 7.36 sur l'ensemble testé. */
          --primary-ink: color-mix(in srgb, var(--primary) 40%, white);
        }
      }
      /* Base partagée par tous les skins */
      body { margin: 0; color: var(--text); background: var(--bg); line-height: 1.5; }
      h1, h2 { font-family: var(--font-display); }
      section { padding: 3rem 1.5rem; max-width: 960px; margin: 0 auto; position: relative; }
      /* Alternance de fond légère : rythme visuel entre sections sans casser
         le "HTML statique, pas de JS framework" du T0 (Chap 24). Mix vers
         var(--bg), PAS vers white en dur — sinon ces surfaces resteraient
         claires même en dark mode. */
      section:nth-of-type(even) { background: color-mix(in srgb, var(--primary) 6%, var(--bg)); }
      .features ul, .faq ul, .pricing ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
      .features li, .faq li, .pricing li { padding: 1rem; }
      blockquote { margin: 0; }
      .btn { background: var(--primary); color: var(--on-primary); font: inherit; cursor: pointer; text-decoration: none; display: inline-block; transition: transform 0.15s ease, opacity 0.15s ease; }
      .btn:hover { transform: translateY(-1px); opacity: 0.9; }
      .badge { display: inline-block; font-size: 0.85rem; font-weight: 600; color: var(--primary); margin: 0 0 1rem; }

      /* Barre de nav : sticky, marque + ancre vers la capture email. Chrome
         générique (pas un bloc du manifest Studio), commun à tous les skins. */
      .site-nav {
        position: sticky; top: 0; z-index: 10;
        display: flex; align-items: center; justify-content: space-between;
        padding: 1rem 1.5rem; background: var(--nav-bg);
        backdrop-filter: blur(6px); border-bottom: 1px solid var(--border);
      }
      .site-nav .brand { font-weight: 700; color: var(--text); text-decoration: none; font-family: var(--font-display); }
      .site-nav .btn { padding: 0.5rem 1rem; font-size: 0.9rem; }

      /* Apparition douce au scroll — CSS pur (scroll-driven animations),
         AUCUN JS : @supports dégrade proprement (contenu simplement visible,
         jamais bloqué à opacity:0) sur les navigateurs qui ne le gèrent pas
         encore. Un essai précédent en JS (classe .js + IntersectionObserver)
         créait un vrai risque de flash "page presque invisible" le temps que
         l'observer se déclenche sur une longue page — évité entièrement ici. */
      @supports (animation-timeline: view()) {
        section:not(.hero) {
          animation: fade-in-up linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 25%;
        }
        @keyframes fade-in-up {
          from { opacity: 0; transform: translateY(14px); }
          to { opacity: 1; transform: translateY(0); }
        }
        /* Reveal échelonné : sans ça, toute une grille de cartes apparaît
           d'un coup (la section anime comme un seul bloc). Borné à 4 enfants
           visibles distinctement — au-delà, même délai que le 4e. */
        .feature-grid > *, .feature-alt > li, .faq-accordion > details {
          animation: fade-in-up linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 25%;
        }
        .feature-grid > *:nth-child(2), .feature-alt > li:nth-child(2), .faq-accordion > details:nth-child(2) { animation-delay: 0.06s; }
        .feature-grid > *:nth-child(3), .feature-alt > li:nth-child(3), .faq-accordion > details:nth-child(3) { animation-delay: 0.12s; }
        .feature-grid > *:nth-child(n+4), .feature-alt > li:nth-child(n+4), .faq-accordion > details:nth-child(n+4) { animation-delay: 0.18s; }
      }

      /* Variantes de layout (Phase 1) — balisage DISTINCT du <ul><li> par
         défaut : les règles par skin ci-dessous posent des bordures
         inconditionnelles sur .features li/.faq li/.pricing li, réutiliser
         <li> pour ces variantes forcerait à les contrer pour chaque
         variante × chaque skin. Marquage séparé = zéro interférence, chemin
         par défaut (layout absent) inchangé byte-for-byte.
         PLACÉ AVANT les blocs par skin ci-dessous à dessein : mêmes
         sélecteurs (.feature-card, etc.), même spécificité — en cas
         d'override par skin (ex. bold, bordures 3px noires), c'est l'ordre
         SOURCE qui tranche l'égalité de spécificité CSS ; l'override doit
         donc venir en dernier pour gagner. */
      .hero--split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; text-align: left; max-width: 1100px; }
      .hero--split .hero-panel { aspect-ratio: 4 / 3; border-radius: 1rem; background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--primary) 55%, var(--bg)), var(--primary) 70%); }
      /* Image hero réelle (Round B) : même sélecteur .hero-panel que le
         panneau dégradé (fallback si aucune image), donc <div> ET <img>
         partagent aspect-ratio/border-radius ci-dessus. width/height/
         object-fit ne s'appliquent qu'à l'<img> (éléments remplacés) — sans
         eux une image ne remplirait pas sa cellule de grille comme le <div>
         le fait nativement (stretch par défaut). */
      img.hero-panel { width: 100%; height: 100%; object-fit: cover; display: block; }
      .hero-image { display: block; width: 100%; max-width: 100%; border-radius: 1rem; margin-top: 2rem; aspect-ratio: 16 / 9; object-fit: cover; }
      @media (max-width: 720px) {
        .hero--split { grid-template-columns: 1fr; text-align: center; }
        .hero--split .hero-panel { order: -1; aspect-ratio: 16 / 9; }
      }
      .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
      .feature-card { padding: 1.25rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, var(--bg)); border-radius: 0.75rem; background: color-mix(in srgb, var(--primary) 4%, var(--bg)); transition: transform 0.15s ease, box-shadow 0.15s ease; }
      .feature-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1); }
      .feature-card h3 { margin: 0 0 0.5rem; font-family: var(--font-display); }
      .feature-alt { list-style: none; padding: 0; display: grid; gap: 1.5rem; counter-reset: feature; }
      .feature-alt li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; counter-increment: feature; }
      .feature-alt li::before { content: counter(feature); font-size: 2rem; font-weight: 800; color: var(--primary); line-height: 1; }
      .testimonial-card blockquote { border: 1px solid color-mix(in srgb, var(--primary) 25%, var(--bg)); border-radius: 1rem; padding: 1.5rem; background: color-mix(in srgb, var(--primary) 4%, var(--bg)); transition: transform 0.15s ease, box-shadow 0.15s ease; }
      .testimonial-card blockquote:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1); }
      .faq-accordion details { padding: 1rem 0; border-bottom: 1px solid var(--border); }
      .faq-accordion summary { cursor: pointer; font-weight: 600; font-family: var(--font-display); }
      .faq-accordion details[open] summary { color: var(--primary); }

      {% if landing.skin == "editorial" %}
      /* skin: editorial — serif, aligné à gauche, grande typo */
      body { font-family: Georgia, "Times New Roman", var(--font), serif; }
      section { max-width: 720px; }
      .hero { text-align: left; padding: 6rem 1.5rem; }
      .hero h1 { font-size: 3.5rem; font-weight: 400; letter-spacing: -0.02em; margin: 0 0 1rem; }
      blockquote { font-size: 1.5rem; font-style: italic; border-left: 3px solid var(--primary); padding-left: 1rem; }
      .btn { padding: 0.75rem 1.5rem; border: none; border-radius: 999px; }
      .features li, .faq li, .pricing li { border-bottom: 1px solid var(--border); }
      .site-nav .brand { font-family: Georgia, "Times New Roman", var(--font), serif; font-style: italic; }
      {% elif landing.skin == "bold" %}
      /* skin: bold — brutaliste, contrasté, blocs anguleux */
      body { font-family: var(--font), system-ui, sans-serif; }
      .hero { text-align: center; padding: 5rem 1.5rem; }
      .hero h1 { font-size: 4rem; font-weight: 900; text-transform: uppercase; margin: 0 0 1rem; }
      section { border-bottom: 4px solid var(--text); }
      .btn { border: 3px solid var(--text); border-radius: 0; font-weight: 800; padding: 0.75rem 1.25rem; }
      .features li, .faq li, .pricing li { border: 3px solid var(--text); }
      .site-nav { border-bottom: 4px solid var(--text); background: var(--surface); backdrop-filter: none; }
      .site-nav .brand { text-transform: uppercase; font-weight: 900; }
      .feature-card, .testimonial-card blockquote { border: 3px solid var(--text); border-radius: 0; background: var(--surface); }
      .hero-panel { border-radius: 0; border: 3px solid var(--text); }
      .faq-accordion details { border-bottom: 3px solid var(--text); }
      {% else %}
      /* skin: clean — SaaS minimal, sans-serif, centré */
      body { font-family: var(--font), system-ui, sans-serif; }
      .hero { text-align: center; padding: 5rem 1.5rem; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 1rem; }
      .btn { padding: 0.75rem 1.25rem; border: none; border-radius: 0.5rem; }
      .features li, .faq li, .pricing li { border: 1px solid var(--border); border-radius: 0.5rem; }
      {% endif %}

      /* --primary comme couleur de TEXTE (pas de fond) doit passer par
         --primary-ink en dark mode (cf. définition sous @media plus haut).
         PLACÉ EN TOUT DERNIER dans <style> à dessein : .badge/.faq-accordion
         ont déjà une règle de couleur non conditionnelle plus haut (base +
         variantes de layout) — à spécificité égale, c'est l'ordre SOURCE qui
         tranche, cette règle doit donc rester la dernière déclarée pour
         gagner quand le media query correspond (bug réel trouvé par capture
         d'écran : le badge restait illisible en dark mode malgré un
         --primary-ink numériquement correct, tant que cette règle vivait
         AVANT la règle de base au lieu d'après). */
      @media (prefers-color-scheme: dark) {
        .badge, .feature-alt li::before, .faq-accordion details[open] summary { color: var(--primary-ink); }
      }
    </style>
    <script>
      // email_capture : POST same-origin /leads (Traefik route vers le
      // landing-collector partagé, Chap 18). Fonctionne pour N formulaires.
      // Vérifie response.ok : un échec silencieux affichait "Merci !" même
      // quand la capture avait réellement échoué côté serveur (bug réel,
      // constaté en prod avant que la route Traefik n'existe).
      async function submitLead(e) {
        e.preventDefault();
        const email = e.target.querySelector('input[type=email]').value;
        let ok = false;
        try {
          const res = await fetch("/leads", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ project: "{{ project_name }}", email }),
          });
          ok = res.ok;
        } catch (_) {}
        e.target.replaceWith(
          document.createTextNode(
            ok ? "Merci !" : "Une erreur est survenue, réessayez plus tard."
          )
        );
        return false;
      }
    </script>
  </head>
  <body>
    {% set capture_block = landing.blocks | selectattr("type", "equalto", "email_capture") | list | first %}
    <nav class="site-nav">
      <a class="brand" href="#">{{ project_name }}</a>
      {% if capture_block %}<a class="btn" href="#email-capture">{{ capture_block.cta }}</a>{% endif %}
    </nav>
    {% for block in landing.blocks -%}
    {% if block.type == "hero" %}
    <section class="hero{% if block.layout == 'split' %} hero--split{% endif %}">
      {% if block.layout == 'split' %}
      <div>
        {% if block.badge %}<p class="badge">{{ block.badge }}</p>{% endif %}
        <h1>{{ block.headline }}</h1>
        <p>{{ block.subhead }}</p>
        {% if block.cta_primary %}
        <a class="btn" href="{{ block.cta_primary.target }}">{{ block.cta_primary.label }}</a>
        {% endif %}
      </div>
      {% if landing.hero_image %}
      <img class="hero-panel" src="{{ landing.hero_image }}" alt="" />
      {% else %}
      <div class="hero-panel" aria-hidden="true"></div>
      {% endif %}
      {% else %}
      {% if block.badge %}<p class="badge">{{ block.badge }}</p>{% endif %}
      <h1>{{ block.headline }}</h1>
      <p>{{ block.subhead }}</p>
      {% if block.cta_primary %}
      <a class="btn" href="{{ block.cta_primary.target }}">{{ block.cta_primary.label }}</a>
      {% endif %}
      {% if landing.hero_image %}
      <img class="hero-image" src="{{ landing.hero_image }}" alt="" />
      {% endif %}
      {% endif %}
    </section>
    {% elif block.type == "features" %}
    <section class="features"{% if block.id %} id="{{ block.id }}"{% endif %}>
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      {% if block.layout == 'grid' %}
      <div class="feature-grid">
        {% for item in block.get("items", []) %}
        <article class="feature-card"><h3>{{ item.title }}</h3><p>{{ item.description }}</p></article>
        {% endfor %}
      </div>
      {% elif block.layout == 'alternating' %}
      <ul class="feature-alt">
        {% for item in block.get("items", []) %}
        <li><div><strong>{{ item.title }}</strong><p>{{ item.description }}</p></div></li>
        {% endfor %}
      </ul>
      {% else %}
      <ul>
        {% for item in block.get("items", []) %}
        <li><strong>{{ item.title }}</strong><p>{{ item.description }}</p></li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% elif block.type == "email_capture" %}
    <section class="capture" id="email-capture" style="text-align:center">
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      {% if block.subhead %}<p>{{ block.subhead }}</p>{% endif %}
      <form onsubmit="return submitLead(event)" data-project="{{ project_name }}">
        <input type="email" placeholder="{{ block.field_placeholder or 'votre@email.com' }}" required />
        <button class="btn" type="submit">{{ block.cta }}</button>
      </form>
      {% if block.legal_note %}<p><small>{{ block.legal_note }}</small></p>{% endif %}
    </section>
    {% elif block.type == "testimonial" %}
    <section class="testimonial{% if block.layout == 'card' %} testimonial-card{% endif %}">
      <blockquote>{{ block.quote }}</blockquote>
      <p>— {{ block.attribution }}</p>
    </section>
    {% elif block.type == "faq" %}
    <section class="faq"{% if block.id %} id="{{ block.id }}"{% endif %}>
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      {% if block.layout == 'accordion' %}
      <div class="faq-accordion">
        {% for item in block.get("items", []) %}
        <details><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>
        {% endfor %}
      </div>
      {% else %}
      <ul>
        {% for item in block.get("items", []) %}
        <li><strong>{{ item.question }}</strong><p>{{ item.answer }}</p></li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% elif block.type == "pricing" %}
    <section class="pricing">
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      <ul>
        {% for plan in block.get("plans", []) %}
        <li>
          <strong>{{ plan.name }}</strong> — {{ plan.price }}
          <ul>{% for feat in plan.get("features", []) %}<li>{{ feat }}</li>{% endfor %}</ul>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {%- endfor %}
  </body>
</html>
