# Contexte de build du backend (Chap 21) : l'image ne doit contenir que le code
# applicatif. Sans ce fichier, le `COPY . .` du Dockerfile embarquerait le
# frontend, le .git et les venv locaux dans l'image de production.

.git
.gitsky
.venv
venv
__pycache__
*.py[co]
.pytest_cache
.ruff_cache

# Le frontend a son propre Dockerfile et son propre contexte (T1/T2) ; le
# backend n'en a pas besoin. vitrine/ N'EST PAS exclu : le build T0 du
# frontend (frontend/Dockerfile.t0) utilise CE contexte (racine du projet)
# précisément pour pouvoir COPY vitrine/landing.html.
frontend
node_modules

# Secrets et bases locales : ne JAMAIS entrer dans une image.
.env
.env.*
!.env.example
*.db
*.sqlite3

# Sauvegardes et journaux de maintenance (Chap 23).
backups
*.log
