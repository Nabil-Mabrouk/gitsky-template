GITSKY_TIER={{ gitsky_tier }}
PROJECT_NAME={{ project_name }}
# Origine publique du frontend (Chap 1) — le CORS du backend (settings.frontend_url,
# défaut localhost:5173 pour le dev) doit matcher l'origine réelle en prod, sinon
# le navigateur bloque silencieusement /api/auth/login (pas d'erreur visible côté
# UI, juste un fetch qui échoue).
FRONTEND_URL=https://{{ project_domain }}
# Origine publique canonique du projet (Chap 10, SEO). Dérivée de project_domain
# comme FRONTEND_URL ci-dessus, jamais laissée à une configuration manuelle :
# un webhook GitHub (Chap 26) ou toute autre URL backend-facing doit préfixer
# l'hôte de cette valeur par "api." avant usage, jamais la lire telle quelle
# (le split frontend/backend api. est câblé en dur dans les labels Traefik,
# Chap 21) — bug de prod réel : SITE_URL non configuré (retombait sur le défaut
# localhost de app/core/config.py) a cassé la création de webhook, puis une
# fois posé, une URL construite dessus sans le préfixe api. atterrissait sur le
# frontend au lieu du backend (200 silencieux, faux positif).
SITE_URL=https://{{ project_domain }}
# Workers Gunicorn en production (Chap 21), lu nativement par Gunicorn. C'est la
# seule chose qui varie par tier au déploiement : promouvoir T1 -> T2 = changer
# cette valeur et redéployer, sans rebuild d'image.
WEB_CONCURRENCY={{ gunicorn_workers }}
# Clé de signature JWT (Chap 7). Générée par projet ; la faire tourner tous les
# 6 mois (calendrier de rotation, Chap 23 §2.2).
SECRET_KEY={{ secret_key }}
{%- if gitsky_tier != "t0" %}
# PostgreSQL du projet (T1/T2). Compose crée cette base au premier démarrage et
# substitue ces valeurs dans docker-compose.yml. Mot de passe généré par projet.
POSTGRES_USER={{ db_name }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ db_name }}
{%- endif %}
{% for flag, value in resolved_modules.items() -%}
{{ flag | upper }}={{ value | string | lower }}
{% endfor -%}
{% if resolved_modules.module_worker -%}
# Intervalle entre deux cycles du worker, en secondes. Défaut 1h.
WORKER_INTERVAL_SECONDS=3600
{% endif -%}
