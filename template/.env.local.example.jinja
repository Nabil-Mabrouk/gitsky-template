# .env.local — credentials opérateur sans valeur dérivable à la génération.
# Copier ce fichier en .env.local et l'ajuster. NE JAMAIS committer .env.local
# (ce fichier -.example- ci l'est ; le vrai .env.local ne l'est jamais, cf.
# .gitignore). Contrairement à .env, .env.local n'est jamais rendu depuis un
# .jinja par `copier update` — il ne peut donc structurellement jamais perdre
# de valeurs manuelles lors d'une mise à jour de template (Chap 23).
{% if gitsky_tier == "t0" -%}
#
# {{ project_name }} est un projet T0 sans module actif nécessitant de
# credential opérateur pour l'instant — ce fichier peut rester vide. S'il est
# promu en T1/T2 avec des modules externes (paiement, email transactionnel),
# les credentials correspondants viendront ici plutôt que dans .env.
{% endif -%}
{% if resolved_modules.module_fleet %}
# Le fleet dashboard orchestre le reste de la flotte (Chap 27) — ces valeurs
# sont propres à CE déploiement, jamais dérivables d'un domaine ou d'un nom
# de projet.
FLEET_GITHUB_TOKEN=
FLEET_GITHUB_WEBHOOK_SECRET=
FLEET_REGISTER_TOKEN=
COLLECTOR_STATS_TOKEN=
GITSKY_GENERATOR_PATH=/opt/gitsky/gitsky-v2/src/generator
GITSKY_MONOREPO_GITDIR=/opt/gitsky/gitsky-v2/.git
PROJECTS_DIR=/opt/gitsky/projects
FLEET_SUBDOMAIN_SUFFIX=.mystudio.com

# SMTP (invitations admin, Chap 9).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
{% endif -%}
