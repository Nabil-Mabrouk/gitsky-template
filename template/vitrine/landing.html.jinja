<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ project_name }}</title>
    <style>
      :root {
        --primary: {{ branding.primary_color }};
        --on-primary: {{ branding.primary_foreground }};
        --font: "{{ branding.font_family }}", system-ui, sans-serif;
      }
      /* Base partagée par tous les skins */
      body { margin: 0; color: #111; line-height: 1.5; }
      section { padding: 3rem 1.5rem; max-width: 960px; margin: 0 auto; position: relative; }
      /* Alternance de fond légère : rythme visuel entre sections sans casser
         le "HTML statique, pas de JS framework" du T0 (Chap 24). */
      section:nth-of-type(even) { background: color-mix(in srgb, var(--primary) 6%, white); }
      .features ul, .faq ul, .pricing ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
      .features li, .faq li, .pricing li { padding: 1rem; }
      blockquote { margin: 0; }
      .btn { background: var(--primary); color: var(--on-primary); font: inherit; cursor: pointer; text-decoration: none; display: inline-block; transition: transform 0.15s ease, opacity 0.15s ease; }
      .btn:hover { transform: translateY(-1px); opacity: 0.9; }
      .badge { display: inline-block; font-size: 0.85rem; font-weight: 600; color: var(--primary); margin: 0 0 1rem; }

      /* Barre de nav : sticky, marque + ancre vers la capture email. Chrome
         générique (pas un bloc du manifest Studio), commun à tous les skins. */
      .site-nav {
        position: sticky; top: 0; z-index: 10;
        display: flex; align-items: center; justify-content: space-between;
        padding: 1rem 1.5rem; background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(6px); border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }
      .site-nav .brand { font-weight: 700; color: #111; text-decoration: none; font-family: var(--font), system-ui, sans-serif; }
      .site-nav .btn { padding: 0.5rem 1rem; font-size: 0.9rem; }

      /* Apparition douce au scroll — CSS pur (scroll-driven animations),
         AUCUN JS : @supports dégrade proprement (contenu simplement visible,
         jamais bloqué à opacity:0) sur les navigateurs qui ne le gèrent pas
         encore. Un essai précédent en JS (classe .js + IntersectionObserver)
         créait un vrai risque de flash "page presque invisible" le temps que
         l'observer se déclenche sur une longue page — évité entièrement ici. */
      @supports (animation-timeline: view()) {
        section:not(.hero) {
          animation: fade-in-up linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 25%;
        }
        @keyframes fade-in-up {
          from { opacity: 0; transform: translateY(14px); }
          to { opacity: 1; transform: translateY(0); }
        }
      }

      /* Variantes de layout (Phase 1) — balisage DISTINCT du <ul><li> par
         défaut : les règles par skin ci-dessous posent des bordures
         inconditionnelles sur .features li/.faq li/.pricing li, réutiliser
         <li> pour ces variantes forcerait à les contrer pour chaque
         variante × chaque skin. Marquage séparé = zéro interférence, chemin
         par défaut (layout absent) inchangé byte-for-byte.
         PLACÉ AVANT les blocs par skin ci-dessous à dessein : mêmes
         sélecteurs (.feature-card, etc.), même spécificité — en cas
         d'override par skin (ex. bold, bordures 3px noires), c'est l'ordre
         SOURCE qui tranche l'égalité de spécificité CSS ; l'override doit
         donc venir en dernier pour gagner. */
      .hero--split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; text-align: left; max-width: 1100px; }
      .hero--split .hero-panel { aspect-ratio: 4 / 3; border-radius: 1rem; background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--primary) 55%, white), var(--primary) 70%); }
      @media (max-width: 720px) {
        .hero--split { grid-template-columns: 1fr; text-align: center; }
        .hero--split .hero-panel { order: -1; aspect-ratio: 16 / 9; }
      }
      .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
      .feature-card { padding: 1.25rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, white); border-radius: 0.75rem; background: color-mix(in srgb, var(--primary) 4%, white); }
      .feature-card h3 { margin: 0 0 0.5rem; font-family: var(--font), system-ui, sans-serif; }
      .feature-alt { list-style: none; padding: 0; display: grid; gap: 1.5rem; counter-reset: feature; }
      .feature-alt li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; counter-increment: feature; }
      .feature-alt li::before { content: counter(feature); font-size: 2rem; font-weight: 800; color: var(--primary); line-height: 1; }
      .testimonial-card blockquote { border: 1px solid color-mix(in srgb, var(--primary) 25%, white); border-radius: 1rem; padding: 1.5rem; background: color-mix(in srgb, var(--primary) 4%, white); }
      .faq-accordion details { padding: 1rem 0; border-bottom: 1px solid #eee; }
      .faq-accordion summary { cursor: pointer; font-weight: 600; font-family: var(--font), system-ui, sans-serif; }
      .faq-accordion details[open] summary { color: var(--primary); }

      {% if landing.skin == "editorial" %}
      /* skin: editorial — serif, aligné à gauche, grande typo */
      body { font-family: Georgia, "Times New Roman", var(--font), serif; }
      section { max-width: 720px; }
      .hero { text-align: left; padding: 6rem 1.5rem; }
      .hero h1 { font-size: 3.5rem; font-weight: 400; letter-spacing: -0.02em; margin: 0 0 1rem; }
      blockquote { font-size: 1.5rem; font-style: italic; border-left: 3px solid var(--primary); padding-left: 1rem; }
      .btn { padding: 0.75rem 1.5rem; border: none; border-radius: 999px; }
      .features li, .faq li, .pricing li { border-bottom: 1px solid #ddd; }
      .site-nav .brand { font-family: Georgia, "Times New Roman", var(--font), serif; font-style: italic; }
      {% elif landing.skin == "bold" %}
      /* skin: bold — brutaliste, contrasté, blocs anguleux */
      body { font-family: var(--font), system-ui, sans-serif; }
      .hero { text-align: center; padding: 5rem 1.5rem; }
      .hero h1 { font-size: 4rem; font-weight: 900; text-transform: uppercase; margin: 0 0 1rem; }
      section { border-bottom: 4px solid #111; }
      .btn { border: 3px solid #111; border-radius: 0; font-weight: 800; padding: 0.75rem 1.25rem; }
      .features li, .faq li, .pricing li { border: 3px solid #111; }
      .site-nav { border-bottom: 4px solid #111; background: #fff; backdrop-filter: none; }
      .site-nav .brand { text-transform: uppercase; font-weight: 900; }
      .feature-card, .testimonial-card blockquote { border: 3px solid #111; border-radius: 0; background: #fff; }
      .hero-panel { border-radius: 0; border: 3px solid #111; }
      .faq-accordion details { border-bottom: 3px solid #111; }
      {% else %}
      /* skin: clean — SaaS minimal, sans-serif, centré */
      body { font-family: var(--font), system-ui, sans-serif; }
      .hero { text-align: center; padding: 5rem 1.5rem; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 1rem; }
      .btn { padding: 0.75rem 1.25rem; border: none; border-radius: 0.5rem; }
      .features li, .faq li, .pricing li { border: 1px solid #eee; border-radius: 0.5rem; }
      {% endif %}
    </style>
    <script>
      // email_capture : POST same-origin /leads (Traefik route vers le
      // landing-collector partagé, Chap 18). Fonctionne pour N formulaires.
      async function submitLead(e) {
        e.preventDefault();
        const email = e.target.querySelector('input[type=email]').value;
        try {
          await fetch("/leads", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ project: "{{ project_name }}", email }),
          });
        } catch (_) {}
        e.target.replaceWith(document.createTextNode("Merci !"));
        return false;
      }
    </script>
  </head>
  <body>
    {% set capture_block = landing.blocks | selectattr("type", "equalto", "email_capture") | list | first %}
    <nav class="site-nav">
      <a class="brand" href="#">{{ project_name }}</a>
      {% if capture_block %}<a class="btn" href="#email-capture">{{ capture_block.cta }}</a>{% endif %}
    </nav>
    {% for block in landing.blocks -%}
    {% if block.type == "hero" %}
    <section class="hero{% if block.layout == 'split' %} hero--split{% endif %}">
      {% if block.layout == 'split' %}
      <div>
        {% if block.badge %}<p class="badge">{{ block.badge }}</p>{% endif %}
        <h1>{{ block.headline }}</h1>
        <p>{{ block.subhead }}</p>
        {% if block.cta_primary %}
        <a class="btn" href="{{ block.cta_primary.target }}">{{ block.cta_primary.label }}</a>
        {% endif %}
      </div>
      <div class="hero-panel" aria-hidden="true"></div>
      {% else %}
      {% if block.badge %}<p class="badge">{{ block.badge }}</p>{% endif %}
      <h1>{{ block.headline }}</h1>
      <p>{{ block.subhead }}</p>
      {% if block.cta_primary %}
      <a class="btn" href="{{ block.cta_primary.target }}">{{ block.cta_primary.label }}</a>
      {% endif %}
      {% endif %}
    </section>
    {% elif block.type == "features" %}
    <section class="features"{% if block.id %} id="{{ block.id }}"{% endif %}>
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      {% if block.layout == 'grid' %}
      <div class="feature-grid">
        {% for item in block.get("items", []) %}
        <article class="feature-card"><h3>{{ item.title }}</h3><p>{{ item.description }}</p></article>
        {% endfor %}
      </div>
      {% elif block.layout == 'alternating' %}
      <ul class="feature-alt">
        {% for item in block.get("items", []) %}
        <li><div><strong>{{ item.title }}</strong><p>{{ item.description }}</p></div></li>
        {% endfor %}
      </ul>
      {% else %}
      <ul>
        {% for item in block.get("items", []) %}
        <li><strong>{{ item.title }}</strong><p>{{ item.description }}</p></li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% elif block.type == "email_capture" %}
    <section class="capture" id="email-capture" style="text-align:center">
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      {% if block.subhead %}<p>{{ block.subhead }}</p>{% endif %}
      <form onsubmit="return submitLead(event)" data-project="{{ project_name }}">
        <input type="email" placeholder="{{ block.field_placeholder or 'votre@email.com' }}" required />
        <button class="btn" type="submit">{{ block.cta }}</button>
      </form>
      {% if block.legal_note %}<p><small>{{ block.legal_note }}</small></p>{% endif %}
    </section>
    {% elif block.type == "testimonial" %}
    <section class="testimonial{% if block.layout == 'card' %} testimonial-card{% endif %}">
      <blockquote>{{ block.quote }}</blockquote>
      <p>— {{ block.attribution }}</p>
    </section>
    {% elif block.type == "faq" %}
    <section class="faq"{% if block.id %} id="{{ block.id }}"{% endif %}>
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      {% if block.layout == 'accordion' %}
      <div class="faq-accordion">
        {% for item in block.get("items", []) %}
        <details><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>
        {% endfor %}
      </div>
      {% else %}
      <ul>
        {% for item in block.get("items", []) %}
        <li><strong>{{ item.question }}</strong><p>{{ item.answer }}</p></li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% elif block.type == "pricing" %}
    <section class="pricing">
      {% if block.headline %}<h2>{{ block.headline }}</h2>{% endif %}
      <ul>
        {% for plan in block.get("plans", []) %}
        <li>
          <strong>{{ plan.name }}</strong> — {{ plan.price }}
          <ul>{% for feat in plan.get("features", []) %}<li>{{ feat }}</li>{% endfor %}</ul>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {%- endfor %}
  </body>
</html>
