# docker-compose.yml — PRODUCTION, généré pour {{ project_name }}.
#
# Le développement utilise docker-compose.dev.yml (hot-reload, ports exposés,
# db exposée pour DBeaver). Ici : images buildées, rien d'exposé hors Traefik.
#
# Labels Traefik pointant vers le domaine du projet ; proxy-net est le réseau
# partagé de toute la flotte (Chap 1). internal-net est privé et isolé : la db
# n'y est JAMAIS joignable depuis Internet (Chap 23 §2.3).
#
# Ne pas éditer à la main : modifier le template du générateur.
services:
  frontend:
    build:
      # Un seul chemin de build pour tous les projets (Chap 24 — décision
      # produit : cohérence du stack, réutilisation du code, plutôt que jeter
      # la vitrine et repartir de zéro selon les modules activés).
      context: ./frontend
      args:
        # Vite inline VITE_API_URL dans le bundle au BUILD (Chap 21) : l'URL de
        # l'API doit donc arriver ici, pas dans environment:.
        VITE_API_URL: "https://api.{{ project_domain }}"
    container_name: {{ project_name }}_frontend
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.frontend-{{ project_name }}.rule=Host(`{{ project_domain }}`)"
      - "traefik.http.routers.frontend-{{ project_name }}.entrypoints=websecure"
      - "traefik.http.routers.frontend-{{ project_name }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.frontend-{{ project_name }}.loadbalancer.server.port=3000"
    networks:
      - proxy-net
      - internal-net
    depends_on:
      - backend
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"

  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ project_name }}_backend
    restart: unless-stopped
    env_file:
      - .env
      # .env.local n'existe pas pour un projet sans credential opérateur
      # (Chap 23) — `required: false` évite l'échec de `docker compose up`
      # que provoquerait un `env_file:` classique pointant sur un fichier
      # absent (comportement par défaut de Compose : erreur, pas un skip
      # silencieux). Contient les credentials sans valeur dérivable à la
      # génération (jeton GitHub, SMTP...) ; jamais lu par Compose pour SA
      # PROPRE substitution ${VAR} (volumes ci-dessous) — seul .env l'est.
      - path: .env.local
        required: false
    environment:
      # Chaque projet a SON conteneur PostgreSQL, sans exception (isolation
      # CPU/IO et plafond de connexions par projet — Chap 18 §2).
      - DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
      - SECRET_KEY=${SECRET_KEY}
      - ENVIRONMENT=production
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.backend-{{ project_name }}.rule=Host(`api.{{ project_domain }}`)"
      - "traefik.http.routers.backend-{{ project_name }}.entrypoints=websecure"
      - "traefik.http.routers.backend-{{ project_name }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.backend-{{ project_name }}.loadbalancer.server.port=8000"
      # Rate limiting du login AU NIVEAU INFRA (doctrine Chap 14 : l'app
      # journalise, Traefik/fail2ban bloquent). Routeur dédié plus prioritaire
      # que le routeur backend, même service : seule /api/auth/login est
      # limitée — chaque essai coûte un hachage argon2, sans limite c'est du
      # credential stuffing et un DoS CPU à bas coût. Inconditionnel : l'auth
      # est core, présente dans tout projet (Chap 2 §1).
      - "traefik.http.middlewares.authlimit-{{ project_name }}.ratelimit.average=5"
      - "traefik.http.middlewares.authlimit-{{ project_name }}.ratelimit.period=1m"
      - "traefik.http.middlewares.authlimit-{{ project_name }}.ratelimit.burst=10"
      - "traefik.http.routers.authlimit-{{ project_name }}.rule=Host(`api.{{ project_domain }}`) && Path(`/api/auth/login`)"
      - "traefik.http.routers.authlimit-{{ project_name }}.entrypoints=websecure"
      - "traefik.http.routers.authlimit-{{ project_name }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.authlimit-{{ project_name }}.priority=100"
      - "traefik.http.routers.authlimit-{{ project_name }}.middlewares=authlimit-{{ project_name }}"
      - "traefik.http.routers.authlimit-{{ project_name }}.service=backend-{{ project_name }}"
    networks:
      - proxy-net
      - internal-net
{%- if resolved_modules.module_fleet %}
      # Lecture directe du landing collector partagé (Chap 19, onglet Leads) :
      # seul module fleet en a besoin — un projet ordinaire n'a aucune raison
      # de joindre ce réseau interne à la flotte.
      - shared-services-net
{%- endif %}
{%- if resolved_modules.module_fleet %}
    volumes:
      # Le wizard de création (Chap 27) invoque `copier.run_copy` DANS ce
      # conteneur : sans accès filesystem réel aux chemins HÔTE que
      # GITSKY_GENERATOR_PATH/PROJECTS_DIR désignent, la génération ne peut
      # matérialiser aucun fichier, quelle que soit la valeur de ces variables
      # dans .env. Chemin hôte == chemin conteneur (comme
      # SHARED_SERVICES_NETWORK ci-dessous) : GITSKY_GENERATOR_PATH lu depuis
      # l'intérieur du conteneur reste valide, sans traduction. Le générateur
      # est monté en lecture seule (il ne fait que le lire) ; PROJECTS_DIR en
      # lecture-écriture (chaque génération y écrit un nouveau projet).
      - ${GITSKY_GENERATOR_PATH:-/opt/gitsky/gitsky-v2/src/generator}:${GITSKY_GENERATOR_PATH:-/opt/gitsky/gitsky-v2/src/generator}:ro
      - ${PROJECTS_DIR:-/opt/gitsky/projects}:${PROJECTS_DIR:-/opt/gitsky/projects}
      # `src/generator` est un sous-module git : son .git est un simple
      # POINTEUR ("gitdir: ../../.git/modules/src/generator"), le vrai
      # dépôt vit dans le .git du monorepo parent. Sans ce montage, tout
      # projet créé via le wizard perd `_commit` dans .copier-answers.yml
      # (aucune erreur visible — Copier n'y résout juste jamais le commit)
      # et ne peut donc plus JAMAIS recevoir `copier update` (bug de prod
      # réel, trouvé en essayant de mettre à jour un projet créé par le
      # wizard). Chemin hôte == chemin conteneur, même principe que ci-dessus.
      - ${GITSKY_MONOREPO_GITDIR:-/opt/gitsky/gitsky-v2/.git}:${GITSKY_MONOREPO_GITDIR:-/opt/gitsky/gitsky-v2/.git}:ro
{%- endif %}
    depends_on:
      db:
        condition: service_healthy
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"

  db:
    image: postgres:16.3-alpine
    container_name: {{ project_name }}_db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
    volumes:
      - db_data:/var/lib/postgresql/data
    # Aucun `ports:` : la db reste strictement sur internal-net (Chap 23 §2.3).
    networks:
      - internal-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "3"

  migrate:
    # Service éphémère : applique core + chaînes des modules activés, puis sort.
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ project_name }}_migrate
    command: python -m scripts.migrate
    env_file:
      - .env
    environment:
      - DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
    networks:
      - internal-net
    depends_on:
      db:
        condition: service_healthy
    restart: "no"

networks:
  proxy-net:
    external: true
    name: proxy-net
  internal-net:
    driver: bridge
    internal: true
{%- if resolved_modules.module_fleet %}
  # Réseau interne de shared_services (Chap 18) — jamais créé ici, seulement
  # rejoint. Nom réel dépendant du nom de projet Compose de shared_services
  # sur le serveur : vérifier avec `docker network ls` au premier déploiement
  # et corriger SHARED_SERVICES_NETWORK dans .env si besoin.
  shared-services-net:
    external: true
    name: ${SHARED_SERVICES_NETWORK:-shared_services_shared-services-net}
{%- endif %}

volumes:
  db_data:
